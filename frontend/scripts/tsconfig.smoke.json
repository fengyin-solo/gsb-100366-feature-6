{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "rootDir": "..",
    "outDir": "/tmp/smoke-out"
  },
  "include": ["../src/api/**/*", "../src/data/**/*", "./smoke-fireteam.ts"]
}
